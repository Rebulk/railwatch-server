+/// `path` without the `base` prefix (`/railwatch/issues` -> `/issues`);
+/// None when it is not under it.
+fn unprefixed<'a>(path: &'a str, base: &str) -> Option<&'a str> {
+    if base.is_empty() {
+        return Some(path);
+    }
+    let rest = path.strip_prefix(base)?;
+    match rest.as_bytes().first() {
+        None => Some("/"),
+        Some(b'/') => Some(rest),
+        _ => None,
+    }
