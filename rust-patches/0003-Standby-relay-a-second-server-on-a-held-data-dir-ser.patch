diff --git a/crates/server/src/standby.rs b/crates/server/src/standby.rs
new file mode 100644
index 0000000..ed80fa7
--- /dev/null
+++ b/crates/server/src/standby.rs
@@ -0,0 +1,168 @@
+//! `standby_relay`: a second `railwatch serve` on a data dir that another
+//! server holds (serve.lock) serves its own address at once instead of
+//! refusing connections until the first one exits.
+//!
+//! The case is two containers of one app sharing the data volume during a
+//! blue/green deploy (the railwatch-server gem runs the server next to each
+//! app process). Each container has its own loopback, so the new
+//! container's agent cannot reach the old container's server, and its own
+//! server must not write the data while the old one does. Until it holds
+//! the lock, the standby splices every connection it accepts, byte for
+//! byte, to `<data_dir>/serve.sock`, where the holder also listens; the
+//! holder answers it like any other (ingest, pages, the live channel). A
+//! Unix socket on the shared volume reaches across network namespaces:
+//! the containers share the host's kernel and the volume's inode.
+//!
+//! The hand-over: the holder stops accepting, drains and exits, which
+//! releases the lock; the standby takes it, starts its writers and
+//! listens on serve.sock itself. A connection accepted in that gap waits:
+//! its connect to serve.sock is retried every RETRY for up to PATIENCE, so
+//! it reaches whichever server is listening by then.
+//!
+//! Without a holder in another namespace (two servers on one host and
+//! loopback), the standby cannot bind the holder's address, and it waits
+//! on the lock as before: the agents already reach the holder there.
+
+use std::future::Future;
+use std::path::{Path, PathBuf};
+use std::time::{Duration, Instant};
+
+use tokio::net::{TcpListener, TcpStream, UnixListener, UnixStream};
+
+pub const SOCKET: &str = "serve.sock";
+/// sun_path holds 108 bytes on Linux and 104 on macOS, NUL included.
+const MAX_SOCKET_PATH: usize = 103;
+const RETRY: Duration = Duration::from_millis(50);
+/// How long a connection accepted in the hand-over gap waits for a server
+/// on serve.sock. The holder's drain is bounded by its HTTP limits; a
+/// standby that has the lock is listening within a second.
+const PATIENCE: Duration = Duration::from_secs(30);
+
+/// `<data_dir>/serve.sock`, or None when the path is too long to bind.
+pub fn socket_path(data_dir: &Path) -> Option<PathBuf> {
+    let path = data_dir.join(SOCKET);
+    (path.as_os_str().len() <= MAX_SOCKET_PATH).then_some(path)
+}
+
+/// For the lock holder: listen on serve.sock, replacing the file a server
+/// that died left behind. Owner-only, like the data it serves.
+pub fn bind(path: &Path) -> std::io::Result<UnixListener> {
+    use std::os::unix::fs::PermissionsExt;
+    match std::fs::remove_file(path) {
+        Ok(()) => {}
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+        Err(e) => return Err(e),
+    }
+    let listener = UnixListener::bind(path)?;
+    std::fs::set_permissions(path, std::fs::Permissions::from_mode(0o600))?;
+    Ok(listener)
+}
+
+/// serve.sock as a listener for serve::run. Its peers are this host's own
+/// servers, so each connection is given the loopback address.
+pub struct Socket(pub UnixListener);
+
+impl axum::serve::Listener for Socket {
+    type Io = UnixStream;
+    type Addr = std::net::SocketAddr;
+
+    async fn accept(&mut self) -> (UnixStream, std::net::SocketAddr) {
+        loop {
+            match self.0.accept().await {
+                Ok((s, _)) => return (s, std::net::SocketAddr::from(([127, 0, 0, 1], 0))),
+                Err(e) => {
+                    tracing::warn!(error = %e, "serve.sock: accept failed");
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                }
+            }
+        }
+    }
+
+    fn local_addr(&self) -> std::io::Result<std::net::SocketAddr> {
+        Ok(std::net::SocketAddr::from(([127, 0, 0, 1], 0)))
+    }
+}
+
+/// Relays every connection accepted on `listener` to `socket` until
+/// `active` resolves (this server holds the lock), then hands the listener
+/// back to be served directly. Connections already relayed finish on the
+/// server that took them.
+pub async fn relay<T>(listener: TcpListener, socket: PathBuf, active: impl Future<Output = T>) -> (TcpListener, T) {
+    let mut active = std::pin::pin!(active);
+    loop {
+        tokio::select! {
+            biased;
+            held = &mut active => return (listener, held),
+            accepted = listener.accept() => match accepted {
+                Ok((client, _)) => {
+                    tokio::spawn(splice(client, socket.clone()));
+                }
+                Err(e) => {
+                    tracing::warn!(error = %e, "standby: accept failed");
+                    tokio::time::sleep(Duration::from_millis(100)).await;
+                }
+            },
+        }
+    }
+}
+
+async fn splice(mut client: TcpStream, socket: PathBuf) {
+    let _ = client.set_nodelay(true);
+    let started = Instant::now();
+    let mut upstream = loop {
+        match UnixStream::connect(&socket).await {
+            Ok(u) => break u,
+            Err(_) if started.elapsed() < PATIENCE => tokio::time::sleep(RETRY).await,
+            Err(e) => {
+                tracing::warn!(error = %e, socket = %socket.display(), "standby: no server answered on serve.sock; closing the connection");
+                return;
+            }
+        }
+    };
+    if let Err(e) = tokio::io::copy_bidirectional(&mut client, &mut upstream).await {
+        tracing::trace!(error = %e, "standby: relayed connection ended");
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    #[test]
+    fn a_socket_path_too_long_to_bind_is_refused() {
+        assert!(socket_path(Path::new("/rails/storage/railwatch")).is_some());
+        assert!(socket_path(&PathBuf::from(format!("/{}", "d".repeat(100)))).is_none());
+    }
+
+    /// A connection accepted before anyone listens on the socket waits for
+    /// the server that turns up there, and the bytes go through both ways.
+    #[tokio::test]
+    async fn a_connection_in_the_gap_reaches_the_server_that_turns_up() {
+        let dir = std::env::temp_dir().join(format!("rw-standby-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let socket = dir.join(SOCKET);
+        let tcp = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = tcp.local_addr().unwrap();
+        let (stop, stopped) = tokio::sync::oneshot::channel::<()>();
+        let relay = tokio::spawn(relay(tcp, socket.clone(), stopped));
+
+        let mut client = TcpStream::connect(addr).await.unwrap();
+        client.write_all(b"ping").await.unwrap();
+        tokio::time::sleep(Duration::from_millis(300)).await;
+
+        let server = bind(&socket).unwrap();
+        let (mut conn, _) = server.accept().await.unwrap();
+        let mut got = [0u8; 4];
+        conn.read_exact(&mut got).await.unwrap();
+        assert_eq!(&got, b"ping");
+        conn.write_all(b"pong").await.unwrap();
+        client.read_exact(&mut got).await.unwrap();
+        assert_eq!(&got, b"pong");
+
+        stop.send(()).unwrap();
+        let (listener, _) = relay.await.unwrap();
+        assert_eq!(listener.local_addr().unwrap(), addr, "the same listener comes back to be served");
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
+}
diff --git a/crates/server/tests/standby_relay.rs b/crates/server/tests/standby_relay.rs
new file mode 100644
index 0000000..359a3c9
--- /dev/null
+++ b/crates/server/tests/standby_relay.rs
@@ -0,0 +1,149 @@
+//! `standby_relay` (standby.rs): a second server on a held data dir serves
+//! its own address at once, relaying to the holder through serve.sock, and
+//! keeps serving it after the hand-over. The two servers here differ by
+//! port; in production they are two containers whose loopbacks differ.
+//! Every batch posted to the standby's address, before, during and after
+//! the hand-over, is stored once.
+
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant};
+
+use flate2::write::GzEncoder;
+
+const BIN: &str = env!("CARGO_BIN_EXE_railwatch");
+
+struct Dir(PathBuf);
+impl Drop for Dir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+fn free_port() -> u16 {
+    std::net::TcpListener::bind("127.0.0.1:0").unwrap().local_addr().unwrap().port()
+}
+
+fn railwatch(data: &Path, port: u16) -> Command {
+    let mut c = Command::new(BIN);
+    c.env("RAILWATCH_DATA_DIR", data)
+        .env("RAILWATCH_BIND", format!("127.0.0.1:{port}"))
+        .env("RAILWATCH_SECRET_KEY_BASE", "00".repeat(64))
+        .env("RAILWATCH_STANDBY_RELAY", "true")
+        .env("RAILWATCH_LOG", "warn")
+        .env("RAILWATCH_ENV_FILE", "/dev/null")
+        .env_remove("RAILWATCH_CONFIG");
+    c
+}
+
+fn up(port: u16) -> bool {
+    get(port, "/up").is_some_and(|(status, _)| status == 200)
+}
+
+fn wait_until(what: &str, f: impl Fn() -> bool) {
+    let started = Instant::now();
+    while !f() {
+        assert!(started.elapsed() < Duration::from_secs(20), "timed out waiting for {what}");
+        std::thread::sleep(Duration::from_millis(20));
+    }
+}
+
+fn get(port: u16, path: &str) -> Option<(u16, String)> {
+    exchange(port, &format!("GET {path} HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n").into_bytes())
+}
+
+fn exchange(port: u16, request: &[u8]) -> Option<(u16, String)> {
+    let mut s = std::net::TcpStream::connect(("127.0.0.1", port)).ok()?;
+    s.set_read_timeout(Some(Duration::from_secs(40))).unwrap();
+    s.write_all(request).ok()?;
+    let mut buf = Vec::new();
+    s.read_to_end(&mut buf).ok()?;
+    let text = String::from_utf8_lossy(&buf).to_string();
+    let status = text.split(' ').nth(1)?.parse().ok()?;
+    Some((status, text.split_once("\r\n\r\n").map(|(_, b)| b.to_string()).unwrap_or_default()))
+}
+
+fn ingest(port: u16, token: &str, execution_id: &str) -> Option<(u16, String)> {
+    let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_secs_f64();
+    let all: serde_json::Value = serde_json::from_str(include_str!("fixtures/wire_fixtures.json")).unwrap();
+    let mut record = all["request"].clone();
+    record["timestamp"] = now.into();
+    record["execution_id"] = execution_id.into();
+    let mut gz = GzEncoder::new(Vec::new(), flate2::Compression::default());
+    gz.write_all(serde_json::to_string(&record).unwrap().as_bytes()).unwrap();
+    gz.write_all(b"\n").unwrap();
+    let body = gz.finish().unwrap();
+    let mut req = format!(
+        "POST /ingest HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\nAuthorization: Bearer {token}\r\nContent-Type: application/x-ndjson\r\n\
+         Content-Encoding: gzip\r\nX-Railwatch-Version: 0.9.2\r\nContent-Length: {}\r\n\r\n",
+        body.len()
+    )
+    .into_bytes();
+    req.extend_from_slice(&body);
+    exchange(port, &req)
+}
+
+fn term(child: &mut Child) {
+    // SAFETY: signalling our own child.
+    unsafe { libc::kill(child.id() as i32, libc::SIGTERM) };
+    child.wait().unwrap();
+}
+
+#[test]
+fn a_standby_relays_to_the_holder_then_takes_over_without_losing_a_batch() {
+    let dir = Dir(std::env::temp_dir().join(format!("rw-standby-relay-{}", std::process::id())));
+    std::fs::create_dir_all(&dir.0).unwrap();
+    let out = railwatch(&dir.0, 0).args(["env", "create", "app-production"]).output().unwrap();
+    assert!(out.status.success(), "{}", String::from_utf8_lossy(&out.stderr));
+    let token = String::from_utf8(out.stdout).unwrap().trim().to_string();
+    let (a, b) = (free_port(), free_port());
+
+    let mut holder = railwatch(&dir.0, a).arg("serve").stdout(Stdio::null()).stderr(Stdio::null()).spawn().unwrap();
+    wait_until("the holder", || up(a));
+    assert!(dir.0.join("serve.sock").exists(), "the holder listens on serve.sock");
+
+    let mut standby = railwatch(&dir.0, b).arg("serve").stdout(Stdio::null()).stderr(Stdio::piped()).spawn().unwrap();
+    wait_until("the standby's own address", || up(b));
+    assert!(standby.try_wait().unwrap().is_none(), "the standby keeps running");
+
+    // Through the standby, while the holder writes.
+    let mut ids = Vec::new();
+    for i in 0..5 {
+        let id = format!("00000000-0000-4000-8000-{i:012}");
+        assert_eq!(ingest(b, &token, &id).map(|r| r.0), Some(200), "batch {i} through the standby");
+        ids.push(id);
+    }
+
+    // Batches keep arriving on the standby's address while the holder
+    // drains and exits; none is refused.
+    let poster = {
+        let token = token.clone();
+        std::thread::spawn(move || {
+            (5..45)
+                .map(|i| {
+                    let id = format!("00000000-0000-4000-8000-{i:012}");
+                    let status = ingest(b, &token, &id).map(|r| r.0);
+                    std::thread::sleep(Duration::from_millis(25));
+                    (id, status)
+                })
+                .collect::<Vec<_>>()
+        })
+    };
+    std::thread::sleep(Duration::from_millis(200));
+    term(&mut holder);
+    for (id, status) in poster.join().unwrap() {
+        assert_eq!(status, Some(200), "{id} across the hand-over");
+        ids.push(id);
+    }
+    assert!(up(b));
+    term(&mut standby);
+    let mut err = String::new();
+    standby.stderr.take().unwrap().read_to_string(&mut err).unwrap();
+    assert!(err.contains("relaying") && err.contains("acquired after"), "the standby says what it did: {err}");
+
+    let tenants = dir.0.join("telemetry");
+    let x = railwatch_server::dashboard::pool::open_tenant_reader(&tenants, "app-production").unwrap();
+    let stored: i64 = x.query_row("SELECT count(*) FROM executions", [], |r| r.get(0)).unwrap();
+    assert_eq!(stored, ids.len() as i64, "every batch stored once");
+}
